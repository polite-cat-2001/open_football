extends SceneTree
# Checks the Godot port of the player stat formula and formation normalization
# against a reference generated by the original C++ code
# (tools/player_stats_reference/main.cpp -> tests/fixtures/player_stats_reference.json).
#
# Every player in the database contributes to the per-stat sums / sums of squares;
# a large deterministic sample is compared stat-by-stat within tolerance, and a
# few teams' formations are compared position-by-position.
#
# Run:  godot --headless --path . -s res://tests/check_player_stats.gd

const FIXTURE_PATH := "res://tests/fixtures/player_stats_reference.json"
const TOLERANCE := 0.00001

var failures: Array[String] = []


func _init() -> void:
	call_deferred("_run")


func _check(condition: bool, message: String) -> void:
	if condition:
		print("  ok: ", message)
	else:
		failures.append(message)
		print("  FAIL: ", message)


func _number(value) -> float:
	if value == null:
		return 0.0
	return float(value)


func _run() -> void:
	_check_formula()
	await _check_database()
	_finish()


func _check_formula() -> void:
	_check(is_equal_approx(PlayerStats.calculate(0.8, 0.5, 27.0), 0.96),
		"a 27-year-old gets base * 1.2 * profile spread")
	_check(is_equal_approx(PlayerStats.calculate(0.8, 0.5, 14.0), 0.48),
		"the youngest age halves the aged base")
	_check(is_equal_approx(PlayerStats.calculate(0.8, 0.5, 40.0), 0.48),
		"the oldest age halves the aged base")
	_check(PlayerStats.calculate(1.0, 1.0, 27.0) == 1.0, "stats clamp at 1.0")
	_check(PlayerStats.calculate(0.1, 0.01, 27.0) == 0.01, "stats clamp at 0.01")
	_check(Formation.role_from_string("ST") == "ST", "known roles survive parsing")
	_check(Formation.role_from_string("nonsense") == "CM", "unknown roles fall back to CM")
	_check(Formation.default_role_position("GK") == Vector2(-1.0, 0.0),
		"the goalkeeper default position is on the goal line")


func _check_database() -> void:
	var fixture = JSON.parse_string(FileAccess.get_file_as_string(FIXTURE_PATH))
	_check(typeof(fixture) == TYPE_DICTIONARY, "the C++ reference fixture is readable")
	if typeof(fixture) != TYPE_DICTIONARY:
		return
	var stat_names: Array = fixture["stat_names"]
	_check(stat_names == PlayerStats.STAT_NAMES, "stat names match the C++ reference")

	var sample_stats := {}
	for sample in fixture["samples"]:
		sample_stats[int(sample["id"])] = sample["stats"]

	var catalog := TeamCatalog.new()
	_check(catalog.load_data_root(), "the catalog loads: " + catalog.error)
	if not catalog.error.is_empty():
		return
	var reader := SqliteReader.new()
	_check(reader.open(catalog.database_path()), "the reader opens: " + reader.error)
	if not reader.error.is_empty():
		return

	var sums := {}
	var sums_squares := {}
	for name in stat_names:
		sums[name] = 0.0
		sums_squares[name] = 0.0
	var accumulator := {
		"count": 0,
		"checked_samples": 0,
		"max_sample_difference": 0.0,
	}
	var callback := func(row: Dictionary) -> void:
		accumulator["count"] += 1
		var stats := PlayerStats.calculate_profile(str(row["profile_xml"]),
			_number(row["base_stat"]), _number(row["age"]))
		for name in stat_names:
			var value := float(stats.get(name, 0.0))
			sums[name] += value
			sums_squares[name] += value * value
		var player_id := int(row["id"])
		if sample_stats.has(player_id):
			accumulator["checked_samples"] += 1
			var expected: Dictionary = sample_stats[player_id]
			for name in stat_names:
				var difference := absf(float(stats.get(name, 0.0)) - float(expected[name]))
				accumulator["max_sample_difference"] = maxf(
					float(accumulator["max_sample_difference"]), difference)
	var streamed := reader.for_each("players",
		PackedStringArray(["id", "age", "base_stat", "profile_xml"]), callback)
	_check(streamed, "every player can be streamed: " + reader.error)
	_check(int(accumulator["count"]) == int(fixture["player_count"]),
		"all %d players are read" % int(fixture["player_count"]))

	var worst_sum := 0.0
	var worst_sum_name := ""
	var worst_square := 0.0
	var worst_square_name := ""
	for name in stat_names:
		var expected_sum := float(fixture["sums"][name])
		var expected_square := float(fixture["sums_squares"][name])
		var sum_difference := absf(float(sums[name]) - expected_sum)
		var square_difference := absf(float(sums_squares[name]) - expected_square)
		if sum_difference > worst_sum:
			worst_sum = sum_difference
			worst_sum_name = name
		if square_difference > worst_square:
			worst_square = square_difference
			worst_square_name = name
	var sum_tolerance := maxf(0.001, float(accumulator["count"]) * 0.000001)
	_check(worst_sum <= sum_tolerance,
		"per-stat sums match the C++ reference (worst %s: %f)" % [worst_sum_name, worst_sum])
	_check(worst_square <= sum_tolerance * 2.0,
		"per-stat sums of squares match (worst %s: %f)" % [worst_square_name, worst_square])
	_check(int(accumulator["checked_samples"]) == sample_stats.size(),
		"the player sample is covered (%d players)" % sample_stats.size())
	_check(float(accumulator["max_sample_difference"]) <= TOLERANCE,
		"sampled player stats match within %f (worst %f)"
			% [TOLERANCE, float(accumulator["max_sample_difference"])])

	_check_formations(reader, fixture)
	_check_squad(catalog, sample_stats)


func _check_formations(reader: SqliteReader, fixture: Dictionary) -> void:
	for expected_team in fixture["formations"]:
		var team_id := int(expected_team["id"])
		var rows := reader.select_indexed("teams", "id", team_id,
			PackedStringArray(["formation_xml"]))
		_check(rows.size() == 1, "formation sample team %d is readable" % team_id)
		if rows.size() != 1:
			continue
		var entries := Formation.parse_and_normalize(str(rows[0]["formation_xml"]))
		var expected_entries: Array = expected_team["entries"]
		_check(entries.size() == expected_entries.size(),
			"team %d has %d formation slots" % [team_id, expected_entries.size()])
		var max_difference := 0.0
		var roles_match := true
		for i in mini(entries.size(), expected_entries.size()):
			var entry: Dictionary = entries[i]
			var expected: Dictionary = expected_entries[i]
			if str(entry["role"]) != str(expected["role"]):
				roles_match = false
			var database_position: Vector2 = entry["database_position"]
			var position: Vector2 = entry["position"]
			max_difference = maxf(max_difference, absf(database_position.x - float(expected["db_x"])))
			max_difference = maxf(max_difference, absf(database_position.y - float(expected["db_y"])))
			max_difference = maxf(max_difference, absf(position.x - float(expected["x"])))
			max_difference = maxf(max_difference, absf(position.y - float(expected["y"])))
		_check(roles_match, "team %d formation roles match the C++ reference" % team_id)
		_check(max_difference <= TOLERANCE,
			"team %d normalized positions match (worst %f)" % [team_id, max_difference])


func _check_squad(catalog: TeamCatalog, sample_stats: Dictionary) -> void:
	var squad := catalog.load_squad(3)
	_check(catalog.error.is_empty(), "team 3 squad loads: " + catalog.error)
	if not catalog.error.is_empty():
		return
	_check(str(squad["team"]["name"]) == "UNAM Pumas", "the squad screen gets the right team")
	_check((squad["formation"] as Array).size() == Formation.SLOT_COUNT,
		"the squad has an eleven-slot formation")
	_check((squad["lineup"] as Array).size() == Formation.SLOT_COUNT,
		"the lineup takes the first eleven players")
	var players: Array = squad["players"]
	_check(players.size() >= Formation.SLOT_COUNT, "the squad has a bench")
	var first: Dictionary = players[0]
	_check(int(first["id"]) == 48 and first["name"] == "Keylor Navas",
		"the first squad player is the first by formation order")
	var expected: Dictionary = sample_stats.get(int(first["id"]), {})
	_check(not expected.is_empty(), "the first squad player is in the C++ sample")
	var worst := 0.0
	for name in PlayerStats.STAT_NAMES:
		worst = maxf(worst, absf(float(first["stats"].get(name, 0.0)) - float(expected.get(name, 0.0))))
	_check(worst <= TOLERANCE, "squad player stats match the C++ reference (worst %f)" % worst)
	var stats_ok := true
	for player in players:
		var stats: Dictionary = player["stats"]
		if stats.size() != PlayerStats.STAT_NAMES.size():
			stats_ok = false
		if float(player["average"]) < PlayerStats.MIN_STAT or float(player["average"]) > PlayerStats.MAX_STAT:
			stats_ok = false
	_check(stats_ok, "every squad player has all final stats in range")

	var national := catalog.load_squad(4407)
	_check(catalog.error.is_empty(), "a national team squad loads: " + catalog.error)
	if not catalog.error.is_empty():
		return
	_check(bool(national["national"]), "national teams are detected by their league")
	var national_players: Array = national["players"]
	_check(national_players.size() >= Formation.SLOT_COUNT,
		"the national squad comes from nationalteam_id (%d players)" % national_players.size())
	_check((national["lineup"] as Array).size() == Formation.SLOT_COUNT,
		"the national lineup has eleven players")
	var order_ok := true
	for i in range(1, national_players.size()):
		if int(national_players[i]["formation_order"]) < int(national_players[i - 1]["formation_order"]):
			order_ok = false
	_check(order_ok, "national players are ordered by nationalteamformationorder")


func _finish() -> void:
	if failures.is_empty():
		print("CHECK PASS: player stats")
		quit(0)
	else:
		for failure in failures:
			print("CHECK FAIL: ", failure)
		quit(1)
