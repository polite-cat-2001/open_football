# Godot editor cache and state
.godot/
*.cfg.user
user.cfg

# Raw Mixamo FBX — не распространяем (public/open-source); коммитим только собранный .glb
assets/models/mixamo_src/

# Сырьё Hunyuan 3D (23 МБ, три 4K-текстуры) — коммитим только собранный .glb
assets/models/hunyuan_src/

tools/__pycache__/
assets/models/gpf_src/*.blend1

# Выходные файлы оракула (трассы и манифесты) — генерируются прогонами, не версионируются
out/

# GDExtension build artifacts
gdextension/build/
gdextension/bin/
# GDExtension runtime build (links GameplayFootball prebuilt libs)
gdextension/build-runtime/
gdextension/build-ofport/
# Built GDExtension DLL and its runtime dependencies
bin/

# Player face cutouts (Transfermarkt-derived, external bundle)
assets/faces/*
!assets/faces/.gdignore

# Local scratch screenshots and probes (not part of the game)
.scratch/
scratch_*.png
scratch_*.png.import
